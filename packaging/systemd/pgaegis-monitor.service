[Unit]
Description=pgaegis production health check
After=network-online.target patroni.service haproxy.service pgbouncer.service

[Service]
Type=oneshot
ExecStart=/usr/bin/pgaegis monitor check --alert
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pgaegis /var/log/pgaegis /var/spool/pgbackrest /run/postgresql
